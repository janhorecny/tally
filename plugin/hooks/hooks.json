{
  "description": "task-counter: intercept /task:* commands (zero tokens) and ingest transcript usage while a task is active.",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/task-counter\" hook SessionStart", "timeout": 10}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/task-counter\" hook UserPromptSubmit", "timeout": 60}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/task-counter\" hook Stop", "timeout": 30}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/task-counter\" hook SubagentStop", "timeout": 30}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/task-counter\" hook PreCompact", "timeout": 30}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/task-counter\" hook SessionEnd", "timeout": 10}]}
    ]
  }
}
